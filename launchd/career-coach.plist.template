<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.career-coach.weekly</string>
  <key>ProgramArguments</key><array><string>__ROOT__/crawler/run.sh</string></array>
  <!-- 매주 일요일 04:00. Mac이 잠들어 있었다면 깨어난 뒤 실행된다 -->
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/data/launchd.out</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/launchd.err</string>
</dict>
</plist>
