# 지원자 프로필 폴더 (기본 profiles/me). cp -r profiles/_template profiles/me
COACH_PROFILE=profiles/me
# 크롤러 User-Agent에 들어갈 연락처(이메일). 크롤링하려면 필수 — 사이트가 차단 대신 연락할 수 있게
COACH_CONTACT=
# 모델 교체 (coach/models.yaml의 이름). 예: local-qwen-small(Ollama). 비우면 routes 기본값(claude CLI)
# COACH_MODEL_REVIEW=
# 리뷰 전에 가릴 이름(쉼표 구분). 이력서의 본인 이름 등
REDACT_NAMES=
# 사람인 오픈 API 키 (https://oapi.saramin.co.kr/ 에서 발급) — 없으면 사람인 수집은 건너뜀
SARAMIN_ACCESS_KEY=
# OpenAI 호환 API 키 (models.yaml의 api_key_env와 이름을 맞춘다)
# DASHSCOPE_API_KEY=
